# VYA — environment variable template
# Copy to .env.local and fill in real values. NEVER commit .env.local (it's gitignored).
# Values here are placeholders only — no real secrets.

# ── Core infrastructure ─────────────────────────────────────────────
DATABASE_URL=                      # Neon Postgres connection string
POSTGRES_URL=                      # (fallback / same as DATABASE_URL)
NEXT_PUBLIC_BASE_URL=https://vyaplatform.com
BLOB_READ_WRITE_TOKEN=             # Vercel Blob (image hosting)

# ── Auth & internal secrets ─────────────────────────────────────────
ADMIN_PASSWORD=                    # admin/cron endpoint gate
AUTH_SECRET=
NEXTAUTH_SECRET=
MOBILE_AUTH_SECRET=                # Expo/RN app auth
AUTH_DEBUG=                        # "true" turns on NextAuth debug logging.
                                   # WARNING: prints the full provider config,
                                   # clientSecret included. Never set in production.
EMAIL_LINK_SECRET=                 # magic-link signing
CRON_SECRET=                       # protects /api/cron/*
VIA_ACCESS_CODE=                   # gated-access code

# ── AI / listing intelligence ───────────────────────────────────────
ANTHROPIC_API_KEY=                 # Claude (intake, pricing, descriptions)
VOYAGE_API_KEY=                    # Voyage multimodal embeddings
SERPAPI_API_KEY=                   # comps + reverse-image
SERPAPI_ENABLED=true
PHOTOROOM_API_KEY=                 # background removal / ghost mannequin
PHOTOROOM_ENABLED=true
# Model overrides (optional — sensible defaults in code)
AI_MODEL_INTAKE=
AI_MODEL_PRICING=
AI_MODEL_ASSISTANT=
AI_MODEL_STOREFRONT=
AI_MODEL_STORE_PROFILE=
AI_MODEL_VOICE=
AI_MODEL_CATEGORIZE=
VISION_MODEL=
VISION_VERIFY_MODEL=
VYA_VISUAL_MATCH_MIN=              # min similarity score for a visual match
INTAKE_AI_CONCURRENCY=
INTAKE_REVERSE_FRAMES=
RN_FTC_LOOKUP=
EVAL_NIGHTLY_PRICE=
EVAL_NIGHTLY_SAMPLE=

# ── Payments (Stripe) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY_CARROLL=         # Carroll St separate account

# ── Store integrations (product + order sync) ───────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
COLLABS_COOKIE=                    # Shopify Collabs session (expires ~days)
COLLABS_CSRF_TOKEN=                # refresh alongside COLLABS_COOKIE
# Square is per-store: storeConfig.accessTokenEnvVar names the var to read, e.g.
#   SQUARE_ACCESS_TOKEN_HONEY_BEAR_VINTAGE / _LOCATION_ID_ / _WEBHOOK_SIG_
# The two generic names below are the fallback when a store names no override.
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
WIX_API_KEY_NELLO_VINTAGE=         # per-Wix-store key (one per store)
SUPABASE_ANON_KEY_CARROLL=         # Carroll St data source
PARTNER_WEBHOOK_TOKEN_CARROLL=

# ── Shipping ────────────────────────────────────────────────────────
SHIP_PROVIDER=shippo               # shippo | easypost
SHIP_SUBACCOUNTS=
SHIPPO_API_KEY=
EASYPOST_API_KEY=

# ── Cross-listing marketplaces ──────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
EBAY_DEFAULT_POSTAL=               # fallback item location postcode
ETSY_KEYSTRING=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=
DEPOP_CLIENT_ID=
DEPOP_CLIENT_SECRET=
DEPOP_TOKEN_URL=

# ── Email / marketing ───────────────────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
LINQ_API_KEY=                      # buyer text notifications (dormant)
LINQ_FROM_NUMBER=
STORE_LISTING_DIGEST_ENABLED=

# ── Social / distribution ───────────────────────────────────────────
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REGION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=

# ── Analytics (Firebase) ────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Ops / platform ──────────────────────────────────────────────────
OPS_ALERT_EMAIL=
VERCEL_API_TOKEN=                  # Vercel API (image re-host cron, etc.)
# Auto-provided by Vercel at runtime (do not set locally):
#   NODE_ENV, VERCEL_ENV, VERCEL_PROJECT_ID, VERCEL_TEAM_ID

# ── Plan B: stores served from their own registrable domain ──────────────────
# When set, {slug}.<suffix> serves that seller's captured storefront from an origin the browser
# isolates from VYA — which is what lets the seller's OWN JavaScript run (carousels, filters, cart
# drawer, predictive search) instead of being imitated by the capture shim.
#
# MUST be a separate registrable domain, never a subdomain of vyaplatform.com: a subdomain is
# same-site and does not isolate (cookie tossing).
#
# Local testing needs no registration — add to /etc/hosts:
#   127.0.0.1  blummier.vyasites.test
# (`.test` is reserved by RFC 6761 and never resolves publicly.)
#
# Unset = Plan B is off entirely; captures keep no scripts and no host is treated as a store origin.
STORE_HOST_SUFFIX=vyasites.test
