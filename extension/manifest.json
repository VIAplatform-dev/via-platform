{
  "manifest_version": 3,
  "name": "VYA Cross-Lister",
  "version": "0.4.2",
  "description": "Cross-list your VYA inventory to Depop & Vestiaire, and sync your listing likes back to VYA — from your own browser.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://vyaplatform.com/*",
    "https://www.depop.com/*",
    "https://depop.com/*",
    "https://*.vestiairecollective.com/*",
    "https://vestiairecollective.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "VYA Cross-Lister",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.depop.com/*",
        "https://depop.com/*"
      ],
      "js": [
        "src/content/depop.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vestiairecollective.com/*",
        "https://vestiairecollective.com/*"
      ],
      "js": [
        "src/content/vestiaire.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
