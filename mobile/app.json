{
  "expo": {
    "name": "VYA",
    "slug": "vya",
    "scheme": "vya",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFFDF8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vyaplatform.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vyaplatform.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFDF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "VYA uses the camera to photograph the pieces you list."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VYA uses your photos so you can list pieces you have already shot."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://vyaplatform.com",
      "router": {},
      "eas": {
        "projectId": "18c737a7-630a-43d4-90c8-b0f60b2277da"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 10000
    },
    "owner": "vyaplatform"
  }
}
