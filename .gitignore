# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# OS dev server build dir (npm run dev:os)
.next-os
.next-verify

# local-only docs / editor config — never push
/SECURITY_AUDIT_2026-08.md
/docs/architecture.md
/.vscode
.eval-cache/

# Fleet evidence: screenshots, per-store JSON and census output. ~300MB and rewritten on every run —
# it is a working artefact, not source. Its conclusions live in docs/handoff/.
.verify/
.next-pop/

# Throwaway probes. Anything named .scratch-* or _* at the root is a one-off from an investigation.
.scratch-*
/_*.mts
/_*.mjs
/gc*.mts

# Expo app (mobile/) — its own build artefacts. The source is tracked; these never are.
mobile/node_modules
mobile/ios
mobile/android
mobile/.expo
mobile/dist
mobile/expo-env.d.ts

# Generated QR images (.qr/) — a pure function of QR_CODES in app/lib/qr-codes.ts.
# Regenerate with `node --experimental-strip-types scripts/make-qr.mts`.
.qr/
